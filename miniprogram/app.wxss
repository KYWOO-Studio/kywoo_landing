/* KYWOO tokens, same as the website's :root */
page {
  --ivory: #f3f0e7;
  --forest: #203e34;
  --forest-deep: #183128;
  --sage: #bdc8b5;
  --line: #c9cfc3;
  --secondary: #52675b;
  --blue: #b9d7e6;
  --paper: #e5e7de;
  background: var(--ivory);
  color: var(--forest);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.8;
  -webkit-font-smoothing: antialiased;
}

.serif {
  font-family: "KYWOO Serif", "Noto Serif SC", "Source Han Serif SC", "Songti SC", "STSong", "SimSun", serif;
  font-weight: 600;
}
.line { display: block; }
.gutter { padding-left: 40rpx; padding-right: 40rpx; }
.section { padding-top: 96rpx; padding-bottom: 96rpx; }

/* section heading with a rule under it */
.kicker {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 24rpx;
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid var(--line);
}
.kicker-title { font-size: 40rpx; letter-spacing: .06em; line-height: 1.4; }
.kicker-sub { font-size: 21rpx; letter-spacing: .1em; color: var(--secondary); text-align: right; }
.kicker.on-dark { border-bottom-color: rgba(243, 240, 231, .22); color: var(--ivory); }
.kicker.on-dark .kicker-sub { color: rgba(243, 240, 231, .66); }

/* big headings */
.display { font-size: 60rpx; line-height: 1.32; letter-spacing: -.01em; }

/* 数据 / 空间 / 活动 pills */
.dirs { display: flex; gap: 10rpx; flex-wrap: wrap; }
.dir {
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  background: var(--forest);
  color: var(--ivory);
  font-size: 21rpx;
  line-height: 1.6;
}
.dir.is-off { background: transparent; color: var(--secondary); box-shadow: inset 0 0 0 1rpx var(--line); opacity: .7; }

.caption { display: block; font-size: 22rpx; line-height: 1.7; color: var(--secondary); }

/* buttons */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 96rpx;
  padding: 0 44rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 500;
}
.btn-primary { background: var(--forest); color: var(--ivory); }
.btn-ghost { background: transparent; color: var(--forest); box-shadow: inset 0 0 0 2rpx var(--forest); }
.btn-hover { opacity: .78; }
button.btn { margin: 0; width: auto; }
button.btn::after { border: none; }

.text-link {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 0;
  border-bottom: 2rpx solid currentColor;
  font-size: 27rpx;
  line-height: 1.4;
}
