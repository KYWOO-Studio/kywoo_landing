.head { padding-top: 56rpx; }
.head-title { margin-top: 36rpx; }

.seg { display: flex; gap: 12rpx; margin-top: 44rpx; }
.seg-item {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  box-shadow: inset 0 0 0 1rpx var(--line);
  font-size: 26rpx;
  line-height: 1.4;
  color: var(--secondary);
  transition: background-color .25s ease, color .25s ease;
}
.seg-item.is-on { background: var(--forest); color: var(--ivory); box-shadow: none; }
.seg-n { margin-left: 6rpx; font-size: 21rpx; opacity: .7; }

.list { padding-top: 44rpx; padding-bottom: 80rpx; }
.case { display: flex; flex-direction: column; padding-bottom: 56rpx; margin-bottom: 52rpx; border-bottom: 1rpx solid var(--line); }
.case:last-child { border-bottom: none; margin-bottom: 0; }
.case-hover .case-img { opacity: .85; }
.case-thumb { position: relative; width: 100%; height: 0; padding-bottom: 66%; overflow: hidden; border-radius: 6rpx; background: var(--paper); }
.case-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.case-meta { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 24rpx; }
.case-kind { font-size: 23rpx; color: var(--secondary); letter-spacing: .04em; }
.case-name { margin-top: 14rpx; font-size: 44rpx; line-height: 1.35; }
.case-sub { margin-top: 6rpx; font-size: 27rpx; color: var(--secondary); line-height: 1.7; }
.case-more { margin-top: 18rpx; font-size: 25rpx; font-weight: 500; }
