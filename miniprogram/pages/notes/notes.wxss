.wrap { padding-top: 56rpx; padding-bottom: 90rpx; }
.kicker-line { display: block; font-size: 20rpx; letter-spacing: .14em; color: var(--secondary); }
.title { display: block; margin-top: 16rpx; padding-bottom: 28rpx; border-bottom: 1rpx solid var(--line); font-size: 52rpx; line-height: 1.3; }
.sec { padding: 32rpx 0; border-bottom: 1rpx solid var(--line); }
.sec-title { display: block; font-size: 30rpx; line-height: 1.5; }
.sec-body { display: block; margin-top: 10rpx; font-size: 25rpx; line-height: 1.85; color: var(--secondary); }
