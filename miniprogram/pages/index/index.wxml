<import src="../../templates/parts.wxml" />

<!-- hero: photos of busy places, full screen under WeChat's own top bar -->
<view class="hero">
  <swiper class="hero-swiper" autoplay interval="5200" duration="900" circular current="{{slide}}" bindchange="onSlide">
    <swiper-item wx:for="{{hero.slides}}" wx:key="src">
      <image class="hero-img" src="{{item.src}}" mode="aspectFill" aria-label="{{item.alt}}" />
    </swiper-item>
  </swiper>
  <view class="hero-shade" />
  <view class="hero-top gutter" style="padding-top: {{nav.top}}px; height: {{nav.height}}px;">
    <view class="wordmark" style="height: {{nav.height}}px;">
      <text class="wm-name">KYWOO</text><text class="wm-studio">STUDIO</text>
    </view>
  </view>
  <view class="hero-content gutter">
    <text class="hero-eyebrow">{{hero.eyebrow}}</text>
    <template is="lines" data="{{lines: hero.titleLines, cls: 'hero-title serif'}}" />
    <text class="hero-lead">{{hero.lead}}</text>
  </view>
  <view class="hero-bar gutter">
    <text class="hero-caption">{{hero.slides[slide].caption}}</text>
    <view wx:if="{{hero.slides.length > 1}}" class="hero-dots">
      <view wx:for="{{hero.slides}}" wx:key="src" class="hero-dot {{index === slide ? 'is-on' : ''}}" data-i="{{index}}" bindtap="goSlide" aria-role="button" aria-label="第 {{index + 1}} 张照片" />
    </view>
  </view>
</view>

<!-- about -->
<view class="section gutter">
  <template is="kicker" data="{{title: about.kicker, sub: about.kickerSub}}" />
  <text class="about-summary serif">{{about.summary}}</text>
</view>

<!-- the other three tabs -->
<view class="entries gutter">
  <view wx:for="{{entries}}" wx:key="tab" class="entry" hover-class="btn-hover" data-tab="{{item.tab}}" bindtap="toTab">
    <text class="entry-num">0{{index + 1}}</text>
    <view class="entry-text">
      <text class="entry-title serif">{{item.title}}</text>
      <text class="entry-sub">{{item.sub}}</text>
    </view>
    <text class="entry-arrow">→</text>
  </view>
</view>

<!-- principles -->
<view class="principles">
  <image class="principles-img" src="{{principles.image.src}}" mode="widthFix" lazy-load aria-label="{{principles.image.alt}}" />
  <text class="caption gutter principles-caption">{{principles.image.caption}}</text>
  <view class="gutter">
    <template is="kicker" data="{{title: principles.label}}" />
    <view wx:for="{{principles.items}}" wx:key="num" class="principle">
      <text class="principle-num">{{item.num}}</text>
      <template is="lines" data="{{lines: item.titleLines, cls: 'principle-title serif'}}" />
      <text class="principle-body">{{item.body}}</text>
      <view wx:if="{{item.types}}" class="types">
        <view wx:for="{{item.types}}" wx:for-item="t" wx:key="name" class="type">
          <text class="type-name">{{t.name}}</text>
          <text class="type-desc">{{t.desc}}</text>
        </view>
      </view>
      <view wx:if="{{item.link}}" class="text-link" hover-class="btn-hover" data-tab="{{item.link.tab}}" data-strategy="{{item.link.strategy}}" bindtap="toTab">{{item.link.label}} →</view>
    </view>
  </view>
</view>

<!-- statement: the phrases come in one after another when the band scrolls into view -->
<view class="statement gutter {{statementIn ? 'is-in' : ''}}">
  <text wx:for="{{statement.phrases}}" wx:key="*this" class="phrase serif" style="transition-delay: {{index * 0.22}}s;">{{item}}</text>
</view>

<!-- footer -->
<view class="footer gutter">
  <view class="wordmark footer-wordmark"><text class="wm-name">KYWOO</text><text class="wm-studio">STUDIO</text></view>
  <text class="footer-slogan">{{footer.slogan}}</text>
  <view class="footer-links">
    <text class="text-link" hover-class="btn-hover" bindtap="toNotes">素材与披露 →</text>
    <text class="text-link" hover-class="btn-hover" bindtap="toTop">返回页首 ↑</text>
  </view>
  <text class="footer-copy">{{footer.copyright}}</text>
</view>
