/* hero */
.hero { position: relative; height: 88vh; min-height: 1000rpx; overflow: hidden; background: var(--forest-deep); color: var(--ivory); }
.hero-swiper, .hero-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.hero-shade {
  position: absolute; top: 0; right: 0; bottom: 0; left: 0;
  background: linear-gradient(180deg, rgba(24, 49, 40, .55) 0%, rgba(24, 49, 40, .06) 22%, rgba(24, 49, 40, .18) 45%, rgba(24, 49, 40, .9) 100%);
  pointer-events: none;
}
.hero-top { position: absolute; top: 0; left: 0; right: 0; pointer-events: none; }
.wordmark { display: flex; align-items: baseline; gap: 10rpx; }
.hero-top .wordmark { align-items: center; }
.wm-name { font-family: Arial, Helvetica, sans-serif; font-size: 40rpx; font-weight: 800; letter-spacing: -.06em; line-height: 1; }
.wm-studio { font-size: 18rpx; letter-spacing: .24em; line-height: 1; opacity: .8; }

.hero-content { position: absolute; left: 0; right: 0; bottom: 150rpx; pointer-events: none; }
.hero-eyebrow { display: block; font-size: 19rpx; letter-spacing: .14em; line-height: 1.6; opacity: .82; }
.hero-title { margin-top: 22rpx; font-size: 54rpx; line-height: 1.3; letter-spacing: -.03em; }
.hero-lead { display: block; margin-top: 26rpx; font-size: 27rpx; line-height: 1.8; opacity: .92; }

.hero-bar { position: absolute; left: 0; right: 0; bottom: 44rpx; display: flex; align-items: center; justify-content: space-between; gap: 30rpx; }
.hero-caption { flex: 1; font-size: 20rpx; line-height: 1.6; opacity: .72; }
.hero-dots { display: flex; gap: 6rpx; }
.hero-dot { width: 44rpx; height: 44rpx; position: relative; }
.hero-dot::after { content: ''; position: absolute; left: 4rpx; right: 4rpx; top: 20rpx; height: 4rpx; border-radius: 4rpx; background: rgba(243, 240, 231, .4); }
.hero-dot.is-on::after { background: var(--ivory); }

/* about */
.about-summary { display: block; margin-top: 44rpx; font-size: 42rpx; line-height: 1.68; letter-spacing: .01em; }

/* entries to the other tabs */
.entries { padding-bottom: 40rpx; }
.entry { display: flex; align-items: center; gap: 28rpx; padding: 34rpx 0; border-top: 1rpx solid var(--line); }
.entry:last-child { border-bottom: 1rpx solid var(--line); }
.entry-num { font-size: 22rpx; color: var(--secondary); letter-spacing: .06em; }
.entry-text { flex: 1; display: flex; flex-direction: column; }
.entry-title { font-size: 36rpx; line-height: 1.4; }
.entry-sub { margin-top: 4rpx; font-size: 22rpx; color: var(--secondary); letter-spacing: .04em; }
.entry-arrow { font-size: 34rpx; }

/* principles */
.principles { padding-top: 56rpx; padding-bottom: 40rpx; }
.principles-img { display: block; width: 100%; background: var(--paper); }
.principles-caption { margin: 16rpx 0 76rpx; }
.principle { padding: 52rpx 0 56rpx; border-bottom: 1rpx solid var(--line); }
.principle:last-child { border-bottom: none; }
.principle-num { display: block; font-size: 84rpx; font-weight: 200; line-height: 1; color: var(--sage); letter-spacing: -.04em; }
.principle-title { margin-top: 18rpx; font-size: 46rpx; line-height: 1.4; }
.principle-body { display: block; margin-top: 18rpx; font-size: 28rpx; line-height: 1.85; color: var(--secondary); }
.types { margin-top: 24rpx; border-top: 1rpx solid var(--line); }
.type { display: flex; justify-content: space-between; gap: 24rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--line); font-size: 25rpx; line-height: 1.6; }
.type-name { font-weight: 600; flex-shrink: 0; }
.type-desc { color: var(--secondary); text-align: right; }
.principle .text-link { margin-top: 26rpx; }

/* statement */
.statement { padding-top: 120rpx; padding-bottom: 130rpx; background: var(--forest); color: var(--ivory); }
.phrase {
  display: inline-block;
  font-size: 50rpx;
  line-height: 1.6;
  opacity: .16;
  transform: translateY(16rpx);
  transition: opacity .7s ease, transform .7s ease;
}
.statement.is-in .phrase { opacity: 1; transform: none; }

/* footer */
.footer { padding-top: 70rpx; padding-bottom: 70rpx; display: flex; flex-direction: column; }
.footer-wordmark { color: var(--forest); }
.footer-slogan { margin-top: 18rpx; font-size: 24rpx; letter-spacing: .08em; color: var(--secondary); }
.footer-links { display: flex; gap: 48rpx; margin-top: 36rpx; }
.footer-copy { margin-top: 48rpx; font-size: 21rpx; color: var(--secondary); letter-spacing: .08em; }
