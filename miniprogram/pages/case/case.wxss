.photos { width: 100%; height: 520rpx; background: var(--paper); }
.photo { width: 100%; height: 100%; }
.photos-ph { display: flex; align-items: center; justify-content: center; background: var(--forest); color: var(--ivory); font-size: 52rpx; }
.photo-caption { margin-top: 16rpx; }

.body { padding-top: 40rpx; padding-bottom: 90rpx; display: flex; flex-direction: column; }
.meta { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.kind { font-size: 23rpx; color: var(--secondary); letter-spacing: .04em; }
.name { margin-top: 22rpx; font-size: 60rpx; line-height: 1.3; }
.sub { margin-top: 10rpx; font-size: 34rpx; line-height: 1.5; color: var(--secondary); }
.para { margin-top: 30rpx; font-size: 29rpx; line-height: 1.9; }
.by { margin-top: 26rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line); font-size: 24rpx; line-height: 1.7; color: var(--secondary); }

.links { display: flex; flex-direction: column; align-items: flex-start; gap: 18rpx; margin-top: 36rpx; }
.report { align-self: stretch; min-height: 108rpx; font-size: 32rpx; }
.note { margin-top: 26rpx; font-size: 23rpx; line-height: 1.75; color: var(--secondary); }

.actions { display: flex; gap: 18rpx; margin-top: 56rpx; }
.actions .btn { flex: 1; min-height: 88rpx; padding: 0 20rpx; font-size: 27rpx; }

.next { display: flex; flex-direction: column; margin-top: 56rpx; padding-top: 30rpx; border-top: 1rpx solid var(--line); }
.next-label { font-size: 22rpx; color: var(--secondary); letter-spacing: .06em; }
.next-name { margin-top: 6rpx; font-size: 38rpx; line-height: 1.4; }
